# =====================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO — FARMACIA VANNESA
# (Copie este archivo como .env y complete sus valores locales/producción)
# =====================================================================

# Configuración del Servidor Web Flask
PORT=5000
FLASK_DEBUG=0
FLASK_ENV=development

# Clave Secreta para Sesiones y Tokens CSRF (Mínimo 32 caracteres seguros)
# Si se deja vacía, el sistema generará una llave única en .secret_key
SECRET_KEY=farmacia_vannesa_default_secure_dev_secret_key_change_in_prod_32

# Modo de Persistencia (Arquitectura Dual / Resiliencia BCP)
# 0 = Intenta Supabase Cloud primero (si está configurado), con fallback a SQLite local
# 1 = Fuerza uso exclusivo de SQLite local (vannesa_db.sqlite)
USE_SQLITE=0

# Configuración de Base de Datos Supabase (PostgreSQL en la Nube)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_role_key

# Configuración de Logging y Auditoría
LOG_LEVEL=INFO
LOG_FILE=logs/farmacia_vannesa.log
